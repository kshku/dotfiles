{
  "$schema": "https://opencode.ai/config.json",

  // =====================================================================
  // Native OpenCode V2 configuration.
  //
  // Both machines now run V2, so this file uses the V2 field names directly:
  // `permissions`, `plugins`, `providers`. V1 has been retired.
  //
  // Editors may still underline these keys: the schema published at the
  // $schema URL above serves the V1 shape. That is an upstream issue, not a
  // real error.
  //
  // V2 permission rules are ORDERED and the LAST match wins, so the broad
  // "ask" comes first and the narrow allows after it. The .env rules go
  // last of all: a blanket `read * -> allow` would otherwise silently
  // override V2's built-in base policy that asks on *.env reads.
  // =====================================================================

  // Ask on everything by default, then allow the read-only surface plus the
  // two actions that must never prompt:
  //   compress  — DCP drives compaction internally and cannot service an
  //               approval prompt, so asking here breaks it.
  //   todowrite — plan/todo bookkeeping, no side effects outside the session.
  //
  // The actions actually evaluated on this install are shell, compress, edit,
  // external_directory, glob, grep, read, skill, subagent, todowrite,
  // webfetch, websearch.
  "permissions": [
    { "action": "*",         "resource": "*",       "effect": "ask" },
    { "action": "read",      "resource": "*",       "effect": "allow" },
    { "action": "glob",      "resource": "*",       "effect": "allow" },
    { "action": "grep",      "resource": "*",       "effect": "allow" },
    { "action": "question",  "resource": "*",       "effect": "allow" },
    { "action": "compress",  "resource": "*",       "effect": "allow" },
    { "action": "todowrite", "resource": "*",       "effect": "allow" },
    { "action": "read",      "resource": "*.env",   "effect": "ask" },
    { "action": "read",      "resource": "*.env.*", "effect": "ask" }
  ],

  "plugins": [
    "@tarquinen/opencode-dcp@latest",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],

  "providers": {
    "ollama": {
      "name": "Ollama (local)",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3-coder-64k": {
          "name": "Qwen Coder 64k",
          "limit": { "context": 65536, "output": 8192 }
        }
      }
    }
  }
}
